{
  "name": "bagrinsergiu/content-placeholder",
  "description": "Brizy content placeholders SDK",
  "keywords": [
    "brizy",
    "content",
    "placeholders"
  ],
  "type": "library",
  "require": {
    "php": ">=7.2.0",
    "phplrt/lexer": "^2.3.6",
    "phplrt/compiler": "^2.3.6",
    "psr/log": "^1 || ^2 || ^3"
  },
  "require-dev": {
    "php": ">=7.4",
    "phpunit/phpunit": "^8"
  },
  "autoload": {
    "psr-4": {
      "BrizyPlaceholders\\": "lib/",
      "BrizyPlaceholdersTests\\": "tests/"
    }
  }
}
