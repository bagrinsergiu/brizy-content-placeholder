{
  "name": "bagrinsergiu/content-placeholder",
  "description": "Brizy content placeholders SDK",
  "keywords": [
    "brizy",
    "content",
    "placeholders"
  ],
  "type": "library",
  "require": {
    "php": ">=8.1",
    "phplrt/lexer": "^3.7",
    "psr/log": "^1 || ^2 || ^3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "phpspec/prophecy-phpunit": "^2"
  },
  "autoload": {
    "psr-4": {
      "BrizyPlaceholders\\": "lib/",
      "BrizyPlaceholdersTests\\": "tests/"
    }
  }
}
